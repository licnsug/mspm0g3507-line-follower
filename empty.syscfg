CAPTURE1.ccp0PinConfig.$name                = "ti_driverlib_gpio_GPIOPinGeneric2";
CAPTURE1.ccp0PinConfig.enableConfig         = true;
CAPTURE1.ccp0PinConfig.internalResistor     = "PULL_UP";

