CAPTURE1.peripheral.$assign                 = "TIMG6";
CAPTURE1.peripheral.ccp0Pin.$assign         = "PB6";
CAPTURE1.ccp0PinConfig.hideOutputInversion  = scripting.forceWrite(false);
